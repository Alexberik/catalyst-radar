# Copy to .env locally. NEVER commit real secrets.
CORS_ORIGINS=https://alexberik.github.io,http://localhost:8000,http://127.0.0.1:8000
DATABASE_PATH=./data/catalyst_radar.sqlite3
HTTP_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=45
GECKOTERMINAL_NETWORKS=solana,base,eth,bsc,arbitrum

# Add keys only after registering. Keep all values server-side.
COINGECKO_DEMO_API_KEY=
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=
GOPLUS_API_KEY=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=

# SEC requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=CatalystRadar research YOUR_EMAIL@example.com
# Comma-separated CIK numbers for companies you want to monitor.
SEC_CIKS=
